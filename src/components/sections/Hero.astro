---
/**
 * 2. Hero: two-line heading, lead, service highlights, and the moving network on the right
 * (canvas). On wide screens the hero stays put (sticky) while the next block slides up over it.
 */
const lines = ["We create.", "We manage."];
const highlights = ["Websites", "Reels and posts", "AI voice calls", "Brand strategy"];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-net" aria-hidden="true">
    <canvas class="net-in" data-scene="plexus"></canvas>
  </div>
  <div class="hero-col">
    <h1 id="hero-title" class="h-display hero-title">
      <span class="h1-line tilt-in">{lines[0]}</span>
      <span class="h1-line wipe-in">{lines[1]}<span class="hl">.</span></span>
    </h1>
    <div class="hero-lead fade-in">
      <p class="lead">You grow.</p>
      <span class="rule" aria-hidden="true"></span>
      <ul class="stats" aria-label="What LUUCESSE creates and manages">
        {highlights.map((item) => <li>{item}</li>)}
      </ul>
      <p class="stats-note">Digital content and growth support for businesses.</p>
    </div>
  </div>
</section>

<style>
  /* Phone layout (the reference at 375px): sizes scale with the screen width. */
  .hero {
    position: relative;
    height: 100vh;
    overflow-x: clip;
  }
  /* The network is the background of the whole hero (owner's call, 2026-10-08): edge to edge,
     full height, faded under the heading and lead on the left and towards the bottom edge. */
  .hero-net {
    position: absolute;
    inset: 0;
    -webkit-mask-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 22%, #000 58%),
      linear-gradient(180deg, #000 72%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 22%, #000 58%),
      linear-gradient(180deg, #000 72%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-net canvas {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--c-art);
  }
  .hero-col {
    position: relative;
    width: 90%;
    height: 100%;
    margin-inline: auto;
    pointer-events: none;
  }
  .hero-col a {
    pointer-events: auto;
  }
  .hero-title {
    position: absolute;
    top: 147px;
    left: 0;
    color: var(--c-white);
  }
  .h1-line {
    display: block;
    white-space: nowrap;
  }
  /* The reference's second line sits 5px (0.07em) lower: its period is set in a taller fallback font. */
  .h1-line + .h1-line {
    margin-top: 0.07em;
  }
  .hero-lead {
    position: absolute;
    left: 2.4vw;
    top: calc(100% - 238px);
  }
  .rule {
    margin-top: 24.5px;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6.4vw;
    margin-top: 24px;
  }
  .stats li {
    display: block;
    max-width: 9rem;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--accent);
    font-weight: 700;
  }
  .stats li + li {
    border-left: 1px solid var(--accent-half);
    padding-left: 1rem;
  }
  .stats-note {
    margin-top: 1rem;
    font-size: 11px;
    color: var(--c-white);
  }

  /* Desktop (the reference at 1440 × 727): the column starts 12px left of the page column; the
     lead block is anchored to the bottom of the screen; the network fills the right 65%. */
  @media (min-width: 751px) {
    .hero-col {
      width: min(1200px, 100% - 64px);
    }
    .hero-title {
      top: 172px;
      left: -12px;
    }
    .hero-lead {
      left: -12px;
      top: calc(100% - 307px);
    }
    .rule {
      margin-top: 48px;
    }
    .stats {
      gap: 48px;
      margin-top: 48px;
    }
    .stats li {
      margin-top: 11px;
      font-size: 16px;
    }
    .stats-note {
      margin-top: 4px;
      font-size: 12px;
    }
  }
</style>

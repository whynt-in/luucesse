---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

const next = [
  "Tell us what your business needs.",
  "We’ll discuss the right mix of website, content, social media, or promotion.",
  "We’ll shape the next step around your goals.",
];
---

<BaseLayout
  title="Contact"
  description={`Tell ${SITE.name} about the decision you are working on. We reply within one working day. ${SITE.phone.display}, ${SITE.email}.`}
>
  <PageHeader title="Tell us about the *decision*" lead="A few lines are enough: what you need to decide, by when, and where your data lives today." />

  <section class="pt-10 pb-24 lg:pb-36">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div id="enquiry" class="scroll-mt-28 lg:col-span-7">
        <h2 class="sr-only">Contact form</h2>
        <ContactForm />
      </div>
      <aside class="lg:col-span-5" aria-labelledby="details-title">
        <h2 id="details-title" class="text-2xl font-light">Reach LUUCESSE</h2>
        <ul class="mt-6 space-y-4 text-lg">
          <li>
            <a href={`mailto:${SITE.email}`} class="contact-link"><Icon name="mail" class="text-accent" />{SITE.email}</a>
          </li>
          <li>
            <a href={`tel:${SITE.phone.tel}`} class="contact-link"><Icon name="phone" class="text-accent" />{SITE.phone.display}</a>
          </li>
        </ul>
        <p class="mt-6 text-muted">Serving Alappuzha, Pathanamthitta, Silvassa, and Dadra and Nagar Haveli.</p>

        <h2 class="mt-12 text-2xl font-light">What happens next</h2>
        <ol class="mt-6 space-y-5">
          {
            next.map((step, i) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-accent text-sm text-accent-text">{i + 1}</span>
                <span class="text-muted">{step}</span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.375rem;
    transition: color 0.2s;
  }
  .contact-link:hover {
    color: var(--accent);
  }
</style>

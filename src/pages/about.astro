---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE } from "../config";
---

<BaseLayout
  title="About"
  description={`${SITE.name} is a content creation and managing agency serving businesses in Kerala, Silvassa, and Dadra and Nagar Haveli.`}
>
  <PageHeader
    title="Build a *stronger presence*"
    lead="LUUCESSE helps businesses get noticed with practical digital tools, thoughtful content, and consistent management."
  />

  <section class="section" aria-labelledby="reach-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="reach-title" class="h-section">Where we <span class="hl">work</span></h2>
      </div>
      <div class="lg:col-span-7">
        <p class="t-big">Our documented service areas are Alappuzha and Pathanamthitta in Kerala, plus Silvassa and Dadra and Nagar Haveli.</p>
        <ul class="mt-10 grid gap-3 text-lg sm:grid-cols-2">
          {SITE.locations.map((location) => <li class="card p-5">{location}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="approach-title">
    <div class="container-x">
      <h2 id="approach-title" class="h-section">One team for your <span class="hl">content</span></h2>
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        <li class="card p-7"><h3 class="text-xl">Create</h3><p class="mt-3 text-muted">Websites, reels, posts, and professional shooting and editing.</p></li>
        <li class="card p-7"><h3 class="text-xl">Manage</h3><p class="mt-3 text-muted">Social media and content management that keeps your presence active.</p></li>
        <li class="card p-7"><h3 class="text-xl">Grow</h3><p class="mt-3 text-muted">Brand strategy, AI-powered assistant calls, and Meta and Google Ads.</p></li>
      </ul>
    </div>
  </section>

  <section class="pb-24 lg:pb-36" aria-labelledby="about-cta-title">
    <div class="container-x">
      <div class="reveal rounded-3xl bg-accent p-8 text-accent-text sm:p-12 lg:p-16">
        <h2 id="about-cta-title" class="h-section">Let’s make your business <span class="opacity-60">easier to find</span></h2>
        <a href={SITE.cta.href} class="btn btn-dark btn-lg mt-12">{SITE.cta.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
